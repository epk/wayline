local json = require('cjson')
local rpc = require('oui.rpc')
local methods = {
    'get_state',
    'get_history',
    'purge_history',
    'set_config',
    'select_tunnel',
    'set_tunnel_enabled',
    'check_update',
    'install_update',
}
local module = {}
local function invoke(method, args)
    local session = rpc.session()
    if not session or session.aclgroup ~= 'root' then
        return rpc.ERROR_CODE_ACCESS
    end
    local input = json.encode(args or {})
    assert(#input <= 32768, 'The request exceeds its size limit.')
    local process = assert(ngx.pipe.spawn({ '/usr/sbin/wayline-ctl', method, input }, {
        stdout_read_timeout = method == 'set_tunnel_enabled' and 75000
            or method == 'select_tunnel' and 45000
            or 12000,
    }))
    local output = process:stdout_read_all()
    assert(output and #output <= 524288, 'The response exceeds its size limit.')
    local response = json.decode(output)
    assert(response.ok == true, response.error or 'The operation failed.')
    return response.result
end
for _, name in ipairs(methods) do
    local method = name
    module[method] = function(args)
        return invoke(method, args)
    end
end
return module
